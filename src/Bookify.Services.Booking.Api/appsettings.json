{
  "PostgreSql": {
    "ConnectionTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 20
  },
  "Payments": {
    "Stripe": {
      "HttpTimeoutSeconds": 20,
      "MaxTransientRetries": 1,
      "RetryBaseDelayMilliseconds": 250
    }
  },
  "Notifications": {
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Bookify",
      "TimeoutMilliseconds": 10000
    },
    "Reminders": {
      "PaymentDeadlineLeadTime": "00:10:00",
      "UpcomingCheckInLeadTime": "1.00:00:00",
      "SelectionWindow": "00:00:30"
    }
  },
  "RequestTimeouts": {
    "Default": "00:00:30",
    "PaymentInitiation": "00:01:00",
    "StripeWebhook": "00:00:45"
  },
  "BackgroundJobs": {
    "Enabled": true,
    "PollingInterval": "00:00:10",
    "BatchSize": 50
  },
  "BookingDeadlines": {
    "ApprovalWindow": "1.00:00:00",
    "PaymentWindow": "00:30:00"
  },
  "HttpSecurity": {
    "TrustedFrontendOrigins": [],
    "ForwardedHeaders": {
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "RateLimiting": {
    "PublicReads": {
      "PermitLimit": 120,
      "Window": "00:01:00"
    },
    "BookingCreation": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "PaymentInitiation": {
      "PermitLimit": 6,
      "Window": "00:01:00"
    },
    "LoginFacing": {
      "PermitLimit": 5,
      "Window": "00:01:00"
    },
    "Webhook": {
      "PermitLimit": 300,
      "Window": "00:01:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "Observability": {
    "Exporters": {
      "Tracing": {
        "Enabled": false,
        "Endpoint": null
      },
      "Metrics": {
        "Enabled": false,
        "Endpoint": null
      }
    }
  },
  "OutboxRetry": {
    "MaxAttempts": 5,
    "BaseDelay": "00:00:30",
    "MaxDelay": "00:15:00",
    "DisabledDelay": "00:05:00"
  }

}
