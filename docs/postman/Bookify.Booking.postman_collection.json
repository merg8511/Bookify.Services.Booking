        {
          "name": "05 — Configurar pricing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/properties/{{propertyId}}/units/{{unitId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "properties",
                "{{propertyId}}",
                "units",
                "{{unitId}}",
                "pricing"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "A pricing configuration is required before availability quotes and booking creation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regularNightlyRate\": 120,\n  \"weekendNightlyRate\": 150,\n  \"extraGuestNightlyRate\": 25,\n  \"currency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — Verificar pricing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/properties/{{propertyId}}/units/{{unitId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "properties",
                "{{propertyId}}",
                "units",
                "{{unitId}}",
                "pricing"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Pricing readable\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Configured USD pricing\", () => {",
                  "        pm.expect(data.currency).to.eql('USD');",
                  "        pm.expect(data.regularNightlyRate).to.eql(120);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Booking A and payment",
      "description": "Public availability -> Guest booking -> Owner approval -> Fake payment initiation and authoritative reads",
      "item": [
        {
          "name": "07 — Cotización y disponibilidad A",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/{{propertyId}}/availability?checkInDate={{paymentCheckInDate}}&checkOutDate={{paymentCheckOutDate}}&guestCount=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "{{propertyId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "checkInDate",
                  "value": "{{paymentCheckInDate}}"
                },
                {
                  "key": "checkOutDate",
                  "value": "{{paymentCheckOutDate}}"
                },
                {
                  "key": "guestCount",
                  "value": "2"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment booking availability 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Room available with USD quote\", () => {",
                  "        pm.expect(data.propertyId).to.eql(pm.variables.get('propertyId'));",
                  "        const unit = data.availableUnits.find(x => x.id === pm.variables.get('unitId'));",
                  "        pm.expect(unit, 'Configured Room must be available').to.exist;",
                  "        pm.expect(unit.quote.currency).to.eql('USD');",
                  "        pm.expect(unit.quote.totalPrice).to.be.above(0);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "08 — Crear Booking A como Guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentBookingIdempotencyKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Do not use Authorization. The response returns Booking-Guest-Token ONCE, in the HTTP header, not JSON. Only the Collection Runner local variable stores it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"rentableUnitId\": \"{{unitId}}\",\n  \"checkInDate\": \"{{paymentCheckInDate}}\",\n  \"checkOutDate\": \"{{paymentCheckOutDate}}\",\n  \"guestCount\": 2,\n  \"guest\": {\n    \"fullName\": \"Postman Guest\",\n    \"email\": \"postman.guest@example.com\",\n    \"phone\": \"+50370000000\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Guest booking A created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    const guestToken = pm.response.headers.get('Booking-Guest-Token');",
                  "    pm.test(\"New guest credential issued exactly once\", () => {",
                  "        pm.expect(guestToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test(\"Booking starts PendingApproval\", () => {",
                  "        pm.expect(data.status).to.eql('PendingApproval');",
                  "        pm.expect(data.bookingReference).to.be.a('string').and.not.empty;",
                  "        pm.expect(data.price.totalPrice).to.be.above(0);",
                  "    });",
                  "    pm.variables.set('paymentBookingId', data.id);",
                  "    pm.variables.set('paymentBookingReference', data.bookingReference);",
                  "    // Security: do not log, export, or persist token beyond this Collection Runner.",
                  "    if (guestToken) pm.variables.set('paymentGuestToken', guestToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 — Booking A por referencia pública (Guest)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Booking-Guest-Token",
                "value": "{{paymentGuestToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{paymentBookingReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{paymentBookingReference}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Guest can read own booking\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Booking reference and state\", () => {",
                  "        pm.expect(data.id).to.eql(pm.variables.get('paymentBookingId'));",
                  "        pm.expect(data.status).to.eql('PendingApproval');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "10 — Aprobar Booking A (Owner)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/properties/{{propertyId}}/bookings/{{paymentBookingId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "properties",
                "{{propertyId}}",
                "bookings",
                "{{paymentBookingId}}",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Approval requires an Owner of the property or Admin. Generates PaymentDueAtUtc."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 — Booking A después de aprobar (Guest)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Booking-Guest-Token",
                "value": "{{paymentGuestToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{paymentBookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{paymentBookingId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Approved booking readable\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Booking is PendingPayment with deadline\", () => {",
                  "        pm.expect(data.status).to.eql('PendingPayment');",
                  "        pm.expect(data.paymentDueAtUtc).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "12 — Iniciar pago Booking A (Guest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Booking-Guest-Token",
                "value": "{{paymentGuestToken}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentInitiationIdempotencyKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Development Fake gateway creates a PENDING payment attempt with fake client_secret. This request does NOT pay the Booking. Do not log or save client_secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{paymentBookingId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment session initiated\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Payment was initiated, not assumed successful\", () => {",
                  "        pm.expect(data.paymentId).to.be.a('string').and.not.empty;",
                  "        pm.expect(data.paymentAttemptId).to.be.a('string').and.not.empty;",
                  "        pm.expect(data.amount).to.be.above(0);",
                  "        pm.expect(data.currency).to.eql('USD');",
                  "        pm.expect(data.status).to.eql('Pending');",
                  "        pm.expect(data.clientSecret).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.variables.set('paymentId', data.paymentId);",
                  "    // Do not save clientSecret; this is a sensitive payment session credential.",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "13 — Consultar estado de pago autoritativo (Guest)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Booking-Guest-Token",
                "value": "{{paymentGuestToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/bookings/{{paymentBookingId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "bookings",
                "{{paymentBookingId}}",
                "status"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment status readable\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Fake payment remains Pending until reconciliation\", () => {",
                  "        pm.expect(data.bookingId).to.eql(pm.variables.get('paymentBookingId'));",
                  "        pm.expect(data.bookingStatus).to.eql('PendingPayment');",
                  "        pm.expect(data.paymentStatus).to.eql('Pending');",
                  "        pm.expect(data.paymentAttemptStatus).to.eql('Pending');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "14 — Leer Payment/Attempts (Owner)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/properties/{{propertyId}}/bookings/{{paymentBookingId}}/payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "properties",
                "{{propertyId}}",
                "bookings",
                "{{paymentBookingId}}",
                "payment"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
