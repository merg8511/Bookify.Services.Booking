{
  "info": {
    "_postman_id": "376ffbe0-b2b6-458c-87a7-ee5c16dd1925",
    "name": "Bookify — Module 24.3 Guided E2E Flow",
    "description": "Ordered, local-only guided flow based on the actual 24.1/24.2 API contracts: Owner creates property/unit/pricing; Guest creates a booking, owner approves, Guest initiates PENDING Fake payment, owner inspects status; second Guest booking is cancelled and inventory released; admin reads. Run ALL folders in Collection Runner, IN ORDER. Requires a valid locally provided Owner/Admin JWT. Run-scoped pm.variables.set stores IDs and Guest credentials temporarily without persisting them. No real Stripe charge or webhook simulation. Never share sensitive request/response history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [],
  "item": [
    {
      "name": "00 — Readiness",
      "description": "Preflight and initialize fresh run-scoped variables",
      "item": [
        {
          "name": "01 — Health + inicializar ejecución",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Initializes unique resource names, future dates and per-logical-operation idempotency keys. Execute via Collection Runner, not individual requests."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fail early if the Owner/Admin token was not provided locally.",
                  "const ownerToken = pm.environment.get('ownerAccessToken');",
                  "if (!ownerToken || ownerToken.startsWith('Bearer ')) {",
                  "    throw new Error('Configure ownerAccessToken with a raw Owner/Admin JWT in your LOCAL Postman environment.');",
                  "}",
                  "// Local variables exist only for this request or Collection Runner execution.",
                  "// Never persist Guest credentials into collection/environment variables.",
                  "const guid = () => pm.variables.replaceIn('{{$guid}}');",
                  "const futureDate = days => {",
                  "    const d = new Date();",
                  "    d.setUTCDate(d.getUTCDate() + days);",
                  "    return d.toISOString().substring(0, 10);",
                  "};",
                  "const runId = guid();",
                  "pm.variables.set('propertyName', 'Bookify Postman ' + runId.slice(0, 8));",
                  "pm.variables.set('paymentCheckInDate', futureDate(60));",
                  "pm.variables.set('paymentCheckOutDate', futureDate(63));",
                  "pm.variables.set('cancelCheckInDate', futureDate(70));",
                  "pm.variables.set('cancelCheckOutDate', futureDate(73));",
                  "pm.variables.set('paymentBookingIdempotencyKey', guid());",
                  "pm.variables.set('cancelBookingIdempotencyKey', guid());",
                  "pm.variables.set('paymentInitiationIdempotencyKey', guid());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API healthy\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"Healthy\");",
                  "});",
                  "pm.test(\"Owner JWT configured locally\", () => {",
                  "    const token = pm.environment.get(\"ownerAccessToken\");",
                  "    pm.expect(token, \"Paste a valid Owner/Admin JWT into the local environment value\").to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(token.startsWith(\"Bearer \"), \"Use the raw token without the Bearer prefix\").to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 — Property and pricing",
      "description": "Owner creates isolated property and configures priced Room",
      "item": [
        {
          "name": "02 — Crear Property (Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Requires Owner/Admin JWT. Creates a fresh property per run, preventing interference with Demo Seed data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{propertyName}}\",\n  \"timeZoneId\": \"America/El_Salvador\",\n  \"checkInTime\": \"15:00:00\",\n  \"checkOutTime\": \"11:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Property created\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.test(\"Property ID returned\", () => pm.expect(data.id).to.match(/^[0-9a-f-]{36}$/i));",
                  "    pm.variables.set('propertyId', data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Consultar Property pública",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/properties/{{propertyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "properties",
                "{{propertyId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Property detail 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const data=pm.response.json();",
                  "    pm.test(\"Property matches create\", () => {",
                  "        pm.expect(data.id).to.eql(pm.variables.get('propertyId'));",
