                  "    const data=pm.response.json();",
                  "    pm.test(\"Unit ID returned\", () => pm.expect(data.id).to.match(/^[0-9a-f-]{36}$/i));",
                  "    pm.variables.set('unitId', data.id);",
                  "}"
